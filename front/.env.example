# Plantilla del entorno del frontend. Copiala como .env.development.
#
# El .gitignore de la raiz ignora `.env.*` y solo deja pasar `.env.example`, asi
# que .env.development NO se versiona: cada quien lo crea en su maquina.
#
# Aqui no va ningun secreto. El token de sesion lo emite la API contra las
# credenciales de la persona; el frontend nunca guarda claves.

# Desarrollo local, perfil http de la API
VITE_API_URL=http://localhost:5121/api

# Perfil https de la API
# VITE_API_URL=https://localhost:7055/api

# Despliegue
# VITE_API_URL=https://api.colorsin.com.co/api
