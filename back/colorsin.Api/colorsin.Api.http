@host = http://localhost:5121

### Conexion con MySQL y conteo de las tablas base
GET {{host}}/health/db
Accept: application/json


# =============================================================================
# AUTENTICACION
#
# Las claves de abajo son de DESARROLLO y estan en el repositorio, en
# infra/mysql/init/07_seed_data.sql. Cambialas antes de exponer nada.
#
# El login guarda el token en la variable {{token}}, que usan las peticiones
# siguientes. Ejecuta el login primero.
# =============================================================================

### Entrar como Administrador General (sin sede: ve toda la red)
# @name login
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "marcela.ospina@colorsin.com.co",
  "password": "Colorsin.Dev.Admin1"
}

###
@token = {{login.response.body.token}}

### Entrar como Gerente de Sucursal de Armenia (sede 2)
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "diana.carvajal@colorsin.com.co",
  "password": "Colorsin.Dev.Gerente2"
}

### Entrar como Operador de Manizales (sede 3)
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "paola.guerrero@colorsin.com.co",
  "password": "Colorsin.Dev.Operador2"
}

### Contrasena incorrecta -> 401
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "marcela.ospina@colorsin.com.co",
  "password": "esta-no-es"
}

### Correo que no existe -> el MISMO 401, sin pistas
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "nadie@colorsin.com.co",
  "password": "esta-no-es"
}

### Quien soy, segun el token
GET {{host}}/api/auth/yo
Authorization: Bearer {{token}}
Accept: application/json

### Quien soy, sin token -> 401
GET {{host}}/api/auth/yo
Accept: application/json


# =============================================================================
# DASHBOARD
#
# Todo es de solo lectura. Los parametros son opcionales: sin ninguno, cada
# endpoint responde por toda la red.
# =============================================================================

### Resumen general - toda la red
GET {{host}}/api/dashboard/resumen
Accept: application/json

### Resumen general - solo la matriz de Cali
GET {{host}}/api/dashboard/resumen?sucursalId=1
Accept: application/json

### Resumen general - cierre de un dia pasado
GET {{host}}/api/dashboard/resumen?fechaCorte=2026-09-15
Accept: application/json


### Ventas - mes en curso (sin fechas, toma el mes actual)
GET {{host}}/api/dashboard/ventas
Accept: application/json

### Ventas - rango explicito, las dos fechas incluidas
GET {{host}}/api/dashboard/ventas?desde=2026-09-01&hasta=2026-09-30
Accept: application/json

### Ventas - una sede, con rankings de 3
GET {{host}}/api/dashboard/ventas?desde=2026-09-01&hasta=2026-09-30&sucursalId=1&top=3
Accept: application/json

### Ventas - rango al reves: responde en ceros, no con error
GET {{host}}/api/dashboard/ventas?desde=2026-09-30&hasta=2026-09-01
Accept: application/json


### Inventario - toda la red, vencimientos a 30 dias
GET {{host}}/api/dashboard/inventario
Accept: application/json

### Inventario - horizonte de un ano y mas lotes
GET {{host}}/api/dashboard/inventario?dias=365&topLotes=20
Accept: application/json

### Inventario - una sede, con los ultimos 5 movimientos
GET {{host}}/api/dashboard/inventario?sucursalId=2&topMovimientos=5
Accept: application/json


### Transferencias - toda la red
GET {{host}}/api/dashboard/transferencias
Accept: application/json

### Transferencias - una sede (cuenta si es origen O destino)
GET {{host}}/api/dashboard/transferencias?sucursalId=2&topNovedades=5
Accept: application/json


# =============================================================================
# Documentacion OpenAPI generada. Solo responde con ASPNETCORE_ENVIRONMENT=Development.
# =============================================================================

### Esquema OpenAPI
GET {{host}}/openapi/v1.json
Accept: application/json
